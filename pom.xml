<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>com.econference</groupId>
    <artifactId>econference-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>econference-backend</name>
    <description>eConference Backend - Modular Monolith</description>

    <properties>
        <java.version>24</java.version>
        <spring-modulith.version>1.3.1</spring-modulith.version>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <modules>
        <module>shared</module>
        <module>mod-auth</module>
        <module>mod-event</module>
        <module>mod-submission</module>
        <module>mod-review</module>
        <module>mod-committee</module>
        <module>mod-registration</module>
        <module>application</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-mod-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-mod-event</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-mod-submission</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-mod-review</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-mod-committee</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.econference</groupId>
                <artifactId>econference-mod-registration</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Common dependencies for all modules -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
